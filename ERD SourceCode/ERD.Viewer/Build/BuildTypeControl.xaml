<src:UserControlBase xmlns:CommonControls="clr-namespace:WPF.Tools.CommonControls;assembly=WPF.Tools"
             xmlns:Specialized="clr-namespace:WPF.Tools.Specialized;assembly=WPF.Tools"  
             xmlns:src="clr-namespace:WPF.Tools.BaseClasses;assembly=WPF.Tools"
             x:Class="ERD.Viewer.Build.BuildTypeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ERD.Viewer.Build"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" x:Name="uxHeaderStack">
            <Specialized:DirectionButton x:Name="uxCollapse" Direction="Down" Click="Collapse_Clicked" />
            <CommonControls:LableItem x:Name="uxHeader" FontWeight="DemiBold" Content="Header" />
        </StackPanel>

        
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="uxContent"  Margin="15,0,0,0" 
            Orientation="Vertical" 
            MinWidth="350"
            HorizontalAlignment="Left">
                <CommonControls:ComboBoxTool x:Name="uxRepeatType"/>
                
                <CommonControls:TextBoxItem x:Name="uxCode"
                                            AcceptsReturn="True"
                                            AcceptsTab="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"
                                            MinHeight="30"
                                            MaxHeight="400"/>  
            </StackPanel>
        </ScrollViewer>
    </Grid>
</src:UserControlBase>
