<src:WindowBase xmlns:DataGridObjects="clr-namespace:WPF.Tools.DataGridObjects;assembly=WPF.Tools" 
                xmlns:CommonControls="clr-namespace:WPF.Tools.CommonControls;assembly=WPF.Tools" 
                x:Class="ERD.Viewer.Git.GitBranchManager"
                xmlns:src="clr-namespace:WPF.Tools.BaseClasses;assembly=WPF.Tools"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:local="clr-namespace:ERD.Viewer.Git"
                mc:Ignorable="d"
                Title="Git Branch Manager" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="45*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="45*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="45*" />
            <RowDefinition Height="3" />
            <RowDefinition Height="45*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Branches" FontWeight="Bold"/>
        <Label Grid.Row="0" Grid.Column="2" Content="Commits" FontWeight="Bold"/>
        <Label Grid.Row="0" Grid.Column="4" Content="Commited files" FontWeight="Bold"/>

        <CommonControls:ViSoTreeView x:Name="uxBanches" Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" />
        
        <CommonControls:VerticalGridSplit Grid.Row="1" Grid.Column="1" />
        
        <DataGridObjects:ViSoDataGrid x:Name="uxHistory" Grid.Row="1" Grid.Column="2"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True" 
                                      SelectionChanged="HistoryRow_Changed"/>

        <CommonControls:VerticalGridSplit Grid.Row="1" Grid.Column="3" />

        <DataGridObjects:ViSoDataGrid x:Name="uxCommitFiles" Grid.Row="1" Grid.Column="4"
                              AutoGenerateColumns="False"
                              IsReadOnly="True" 
                              SelectionChanged="CommitedRow_Changed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Path"
                                    Binding="{Binding FilePath}" />

                <DataGridTextColumn Header="Change Type"
                                    Binding="{Binding ChangeType}" />

                <DataGridTextColumn Header="Insert and/or Delete"
                                    Binding="{Binding ChangeIndicator}" />
            </DataGrid.Columns>
        </DataGridObjects:ViSoDataGrid>
        
        <CommonControls:HorizontalGridSplit Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5" />

        <Grid Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48*" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="48*" />
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <RichTextBox  x:Name="uxPreviousFile"  Grid.Row="1" Grid.Column="0" IsReadOnly="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.ScrollChanged="RichTextBox_ScrollChanged" />

            <CommonControls:VerticalGridSplit Grid.Row="1" Grid.Column="1" />

            <RichTextBox  x:Name="uxCommitedFile"  Grid.Row="1" Grid.Column="2" IsReadOnly="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.ScrollChanged="RichTextBox_ScrollChanged" />
        </Grid>
    </Grid>
</src:WindowBase>
